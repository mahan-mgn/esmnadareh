# PostgreSQL connection string used by Prisma and the app.
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/esmnadareh?schema=public"

# Signs the session cookie. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"

# Absolute origin, used for metadata and canonical URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ZarinPal merchant id (UUID from the ZarinPal panel). Set it and the shop
# switches from the built-in simulated gateway to the real one — there is no
# other flag. ZARINPAL_SANDBOX=1 points at the sandbox host for test payments.
ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX=""

# SMTP for order receipts and status mails. With SMTP_HOST unset, messages are
# written to the server log instead of being sent — fine for development.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="اسم نداره <no-reply@esmnadareh.com>"
# Copy of every new order goes here. Leave empty to switch that off.
SHOP_EMAIL=""

# Bearer token for GET /api/inventory/sweep, which releases stock held by
# abandoned checkouts. Leave unset to keep the endpoint closed; the same sweep
# also runs whenever someone checks out or opens the gateway page.
CRON_SECRET=""
